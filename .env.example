# Секреты. Скопируй в .env и заполни. Файл .env никому не отправляй и не выкладывай.

# Telegram API: https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Номер телефона аккаунта в международном формате (необязательно — спросит при входе)
TG_PHONE=

# Токен бота от @BotFather — через этого бота ты общаешься с ассистентом
BOT_TOKEN=

# Твой Telegram ID (необязательно — по умолчанию владелец = аккаунт, под которым выполнен login)
OWNER_ID=

# Ключ Claude API: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
